#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
package_dir="$(mktemp -d)"
trap 'rm -rf "$package_dir"' EXIT

cd "$repo_root"
gem_file="$package_dir/imagusu_design_system.gem"
gem build imagusu_design_system.gemspec --output "$gem_file" >/dev/null

gem_home="$package_dir/gems"
env -i HOME="$HOME" PATH="$PATH" GEM_HOME="$gem_home" GEM_PATH="$gem_home" gem install "$gem_file" --no-document >/dev/null

(cd "$package_dir" && env -i HOME="$HOME" PATH="$PATH" GEM_HOME="$gem_home" GEM_PATH="$gem_home" ruby "$repo_root/script/package-smoke-host.rb")
gem specification "$gem_file" files --yaml | grep -q "app/views/imagusu/design_system/_button.html.erb"
gem specification "$gem_file" files --yaml | grep -q "app/views/imagusu/design_system/_text_field.html.erb"
if gem specification "$gem_file" files --yaml | grep -q "app/components/"; then
  echo "built gem contains forbidden app/components files" >&2
  exit 1
fi
