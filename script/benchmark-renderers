#!/usr/bin/env ruby
# frozen_string_literal: true

require "etc"
require "rbconfig"
require "active_model"
require "capybara"
require_relative "../test/dummy/config/environment"

WARMUPS = 200
SAMPLES = 40

class RendererBenchmarkModel
  include ActiveModel::Model

  attr_accessor :email
end

def percentile(values, fraction)
  sorted = values.sort
  sorted.fetch(((sorted.length - 1) * fraction).ceil)
end

def measure(label, batch:, callable:)
  WARMUPS.times { callable.call }

  durations = []
  allocations = []

  SAMPLES.times do
    before_allocations = GC.stat(:total_allocated_objects)
    started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    batch.times { callable.call }
    finished_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)

    durations << ((finished_at - started_at) * 1_000_000 / batch)
    allocations << ((GC.stat(:total_allocated_objects) - before_allocations).to_f / batch)
  end

  {
    label: label,
    p50_us: percentile(durations, 0.50),
    p95_us: percentile(durations, 0.95),
    allocations: percentile(allocations, 0.50),
    batch: batch
  }
end

def print_results(order, results)
  puts
  puts "ORDER #{order}"
  puts "renderer,scenario,batch,p50_us,p95_us,allocations_per_render"
  results.each do |result|
    puts [
      result.fetch(:label),
      result.fetch(:batch),
      format("%.2f", result.fetch(:p50_us)),
      format("%.2f", result.fetch(:p95_us)),
      format("%.2f", result.fetch(:allocations))
    ].join(",")
  end
end

def command_output(*command)
  IO.popen(command, err: File::NULL) { |io| io.read.strip }
rescue Errno::ENOENT
  "unavailable"
end

view_context = Class.new(ActionController::Base).new.view_context
resolvers = view_context.lookup_context.view_paths
resolvers.each { |resolver| resolver.caching = true }
abort "every template resolver must cache during the benchmark" unless resolvers.all?(&:caching?)

form = ActionView::Helpers::FormBuilder.new(:profile, nil, view_context, {})

invalid_model = RendererBenchmarkModel.new(email: "ada@example.com")
invalid_model.errors.add(:email, "is invalid")
invalid_form = ActionView::Helpers::FormBuilder.new(:profile, invalid_model, view_context, {})

renderers = {
  "legacy,button" => {
    batch: 1_000,
    callable: -> do
      component = Imagusu::DesignSystem::ButtonComponent.new(type: :submit)
      component.with_content("Save")
      component.render_in(view_context)
    end
  },
  "native,button" => {
    batch: 1_000,
    callable: -> do
      view_context.render(
        partial: "imagusu/design_system/button",
        locals: {content: "Save", type: :submit}
      )
    end
  },
  "legacy,text_field" => {
    batch: 200,
    callable: -> do
      Imagusu::DesignSystem::TextFieldComponent.new(
        form: form,
        method: :email,
        label: "Email",
        hint: "Work address",
        errors: ["is invalid"],
        required: true
      ).render_in(view_context)
    end
  },
  "native,text_field" => {
    batch: 200,
    callable: -> do
      view_context.render(
        partial: "imagusu/design_system/text_field",
        locals: {
          form: form,
          method: :email,
          label: "Email",
          hint: "Work address",
          errors: ["is invalid"],
          required: true
        }
      )
    end
  },
  "legacy,text_field_auto_error" => {
    batch: 200,
    callable: -> do
      Imagusu::DesignSystem::TextFieldComponent.new(
        form: invalid_form,
        method: :email,
        label: "Email"
      ).render_in(view_context)
    end
  },
  "native,text_field_auto_error" => {
    batch: 200,
    callable: -> do
      view_context.render(
        partial: "imagusu/design_system/text_field",
        locals: {form: invalid_form, method: :email, label: "Email"}
      )
    end
  }
}

puts "commit=#{`git rev-parse HEAD`.strip}"
puts "ruby=#{RUBY_DESCRIPTION}"
puts "rails=#{Rails.version}"
puts "view_component=#{ViewComponent::VERSION::STRING}"
puts "platform=#{RbConfig::CONFIG.fetch("host_os")} #{RbConfig::CONFIG.fetch("host_cpu")}"
puts "processors=#{Etc.nprocessors}"
puts "hardware_model=#{command_output("sysctl", "-n", "hw.model")}" if RbConfig::CONFIG.fetch("host_os").include?("darwin")
puts "power=#{command_output("pmset", "-g", "batt").lines.first.to_s.strip}" if RbConfig::CONFIG.fetch("host_os").include?("darwin")
puts "template_caching=true"
puts "warmups=#{WARMUPS} samples=#{SAMPLES}"

legacy_first = renderers.keys
native_first = [
  "native,button",
  "legacy,button",
  "native,text_field",
  "legacy,text_field",
  "native,text_field_auto_error",
  "legacy,text_field_auto_error"
]

print_results("legacy/native", legacy_first.map { |key| measure(key, **renderers.fetch(key)) })
print_results("native/legacy", native_first.map { |key| measure(key, **renderers.fetch(key)) })

puts
puts "OUTPUT"
renderers.each do |label, renderer|
  output = renderer.fetch(:callable).call
  puts "#{label},bytes=#{output.bytesize},elements=#{Capybara.string(output).all("body *").count}"
end
