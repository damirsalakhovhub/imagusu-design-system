<div class="ids-field ids-field--checkbox" data-state="<%= state_tokens %>">
  <div class="ids-checkbox">
    <%= content %>
    <%= tag.label(for: @control_id, class: "ids-checkbox__label") do %>
      <%= @label %><% if @label_suffix %> <span class="ids-field__label-suffix"><%= @label_suffix %></span><% end %>
    <% end %>
  </div>
  <% if @hint %>
    <div id="<%= hint_id %>" class="ids-field__hint"><%= @hint %></div>
  <% end %>
  <% if @errors.any? %>
    <div id="<%= error_id %>" class="ids-field__error"><%= error_text %></div>
  <% end %>
</div>
