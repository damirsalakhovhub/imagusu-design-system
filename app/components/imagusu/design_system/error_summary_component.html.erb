<%= tag.div(**container_attributes) do %>
  <%= tag.div(**alert_attributes) do %>
    <h2 id="<%= title_id %>" class="ids-error-summary__title"><%= @title %></h2>
    <% if @description %><div class="ids-error-summary__description"><%= @description %></div><% end %>
    <ul class="ids-error-summary__list">
      <% errors.each do |error| %>
        <li class="ids-error-summary__item">
          <%= tag.a(error[:message], href: "##{error[:field_id]}", class: "ids-error-summary__link") %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
