<% Imagusu::DesignSystem::BadgeComponent::TONES.each do |tone| %>
  <%= render Imagusu::DesignSystem::BadgeComponent.new(tone: tone) { tone.to_s.capitalize } %>
<% end %>
<% Imagusu::DesignSystem::AlertComponent::TONES.each do |tone| %>
  <%= render Imagusu::DesignSystem::AlertComponent.new(title: tone.to_s.capitalize, tone: tone) { "Example #{tone} message." } %>
<% end %>
