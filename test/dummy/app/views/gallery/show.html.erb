<main>
  <h1>Imagusu Design System gallery</h1>

  <section aria-labelledby="buttons-heading">
    <h2 id="buttons-heading">Button</h2>
    <%= render "imagusu/design_system/button", content: "Button" %>
    <%= render "imagusu/design_system/button", content: "Submit", type: :submit %>
    <%= render "imagusu/design_system/button", content: "Disabled", disabled: true %>
  </section>

  <section aria-labelledby="text-fields-heading">
    <h2 id="text-fields-heading">Text field</h2>
    <%= form_with scope: :profile, url: "/", method: :post do |form| %>
      <%= render "imagusu/design_system/text_field", form: form, method: :name, label: "Name" %>
      <%= render "imagusu/design_system/text_field", form: form, method: :email, label: "Email", type: :email, hint: "We will only use this for account messages" %>
      <%= render "imagusu/design_system/text_field", form: form, method: :invalid_email, label: "Invalid email", type: :email, errors: ["Enter an email address"] %>
      <%= render "imagusu/design_system/text_field", form: form, method: :password, label: "Password", type: :password, required: true %>
      <%= render "imagusu/design_system/text_field", form: form, method: :disabled, label: "Disabled", disabled: true %>
    <% end %>
  </section>
</main>
